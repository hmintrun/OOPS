# Supabase dev project only. Copy to .env.local and supply your own values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Optional CA certificate in PEM format, for hosts such as Vercel.
DATABASE_CA_PEM=
# Optional local CA certificate path; DATABASE_CA_PEM takes precedence when set.
DATABASE_CA_FILE=

# Canonical app origin (no trailing path). Used for origin checks and invite URLs.
APP_URL=http://localhost:3000
# Stable server-only secret (at least 32 bytes), used to generate invite tokens.
OOPS_INVITE_SECRET=

# Dev seed, live Auth smoke, and private Storage. Never expose the secret key to the browser.
OOPS_DEV_PROJECT_REF=
SUPABASE_SECRET_KEY=
OOPS_DEMO_PASSWORD=

# Dedicated integration DB. Must match the dev project, or a loopback-only test instance.
OOPS_TEST_DATABASE_URL=

# Enable simulated collections and ops posting only in demo/dev.
OOPS_PAYMENT_MODE=

# Required for new offers. Set each duration to a whole number of hours (1–8760).
# From voting round opening to voting close.
OOPS_VOTE_HOURS=3
# From voting close to the seller response deadline.
OOPS_SELLER_RESPONSE_HOURS=3
# From the verified Fuji opening timestamp to the shared signing and goods payment deadline.
OOPS_FUJI_SIGN_HOURS=12
# From the verified Fuji opening timestamp to the seller deposit deadline.
OOPS_DEPOSIT_HOURS=6

# Existing private Supabase Storage bucket for handoff evidence.
OOPS_EVIDENCE_BUCKET=
# Server-only Gemini developer API key and a model supporting structured output.
GEMINI_API_KEY=
GEMINI_MODEL=

# Fuji DEV 3 deployment. RPC and credential ABI stay on the server.
OOPS_FUJI_RPC_URL=
OOPS_FUJI_CONFIRMATION_CONTRACT=
OOPS_FUJI_CREDENTIAL_CONTRACT=
OOPS_FUJI_CREDENTIAL_ABI=
