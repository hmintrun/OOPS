{
  "name": "oops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "contracts:build": "node scripts/compile-contracts.mjs",
    "fuji:setup": "node --env-file-if-exists=.env.local scripts/fuji-setup.mjs",
    "worker": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/worker.mjs",
    "worker:once": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/worker.mjs --once",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=.env.local scripts/test-db.mjs",
    "test:auth": "node --env-file-if-exists=.env.local scripts/smoke-auth.mjs",
    "test:registration": "node --env-file-if-exists=.env.local scripts/smoke-registration.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@alchemy/wallet-apis": "5.3.0",
    "@openfort/openfort-js": "2.6.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.57.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "solc": "0.8.38",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
