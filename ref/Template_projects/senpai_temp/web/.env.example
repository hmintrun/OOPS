# `npm run setup` writes .env.local for you; this file only documents the keys.

# Avalanche Fuji C-Chain (testnet). Any EVM chain works for local testing.
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# MiuCoin (MIU) address, written by `npm run token:deploy`.
NEXT_PUBLIC_TOKEN_ADDRESS=

# Server only. The relayer is SenpAI's own x402 facilitator: it submits the
# EIP-3009 transfers, pays gas in test AVAX, and owns MiuCoin for the faucet.
RELAYER_PRIVATE_KEY=

# Where the 10 MIU per session goes. Leave empty to receive on the relayer.
PAY_TO=

# Signs login sessions and interview tickets. At least 32 characters.
APP_SECRET=

# Optional: SQLite file for accounts and history. Defaults to data/senpai.db.
DB_PATH=

# Server only. Claude plays Miu (interview turns, feedback, warm-up).
# Or run `ant auth login` instead of setting a key.
DEEPSEEK_API_KEY=
# Optional: defaults to deepseek-flash.
DEEPSEEK_MODEL=

# Or Claude instead of DeepSeek: AI_PROVIDER=claude. The DeepSeek key is then unused.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Optional: where `npm run model:pull` puts the pronunciation model (~300 MB).
# Defaults to data/models. Without the model, answers just aren't scored for pronunciation.
PRON_MODEL_DIR=

# Optional: Miu's voice. Default "edge" (Microsoft Edge's read-aloud voices, no key needed);
# "minimax" uses MiniMax text-to-speech with MINIMAX_API_KEY. Without a voice the browser's voices are used.
TTS_PROVIDER=
MINIMAX_API_KEY=
# Optional: defaults to speech-2.8-turbo.
MINIMAX_TTS_MODEL=
